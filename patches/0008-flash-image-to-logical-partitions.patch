+bool TWPartition::Wipe_EROFS() {
+	Find_Actual_Block_Device();
+	if (!Is_Present) {
+		LOGINFO("Block device not present, cannot wipe %s.\n", Display_Name.c_str());
+		gui_msg(Msg(msg::kError, "unable_to_wipe=Unable to wipe {1}.")(Display_Name));
+		return false;
+	}
+
+	// EROFS is a read-only filesystem and this recovery has no mkfs.erofs, so
+	// a filesystem cannot be recreated in place.  Zero the first 4 KiB (the
+	// superblock starts at offset 1024) so the partition is empty; a fresh
+	// image can be written with Install Image afterwards.
+	gui_msg(Msg("formatting_using=Formatting {1} using {2}...")(Display_Name)("zero fill"));
+	string Command = "dd if=/dev/zero of='" + Actual_Block_Device + "' bs=4096 count=1 conv=fsync";
+	LOGINFO("Wipe command: '%s'\n", Command.c_str());
+	if (TWFunc::Exec_Cmd(Command) != 0) {
+		gui_msg(Msg(msg::kError, "unable_to_wipe=Unable to wipe {1}.")(Display_Name));
+		return false;
+	}
+
+	Current_File_System = "erofs";
+	gui_msg("done=Done.");
+	return true;
+}
