+// Returns the sysfs file used for the temperature shown in the status bar.
+//
+// TWRP's built-in default is thermal_zone0, but the zone order is not fixed:
+// on MT6768 (a14m) zone0 is mtk-master-charger and always reads 0, while the
+// real CPU zone is called mtktscpu (and moves between zone numbers).  Prefer
+// TW_CUSTOM_CPU_TEMP_PATH when the device tree sets one, then look for the
+// MediaTek CPU zone by name, so the value no longer depends on the order in
+// which the thermal zones were probed.
+//
+// The stock recovery kernel is a reduced build: in recovery it only registers
+// the charger and battery zones (thermal_zone0..7) and no CPU zone at all,
+// even though the normal Android kernel has mtktscpu.  Returning zone0 in that
+// case shows a permanent 0.  Falling back to the battery zone at least gives a
+// live temperature, so the status bar is not stuck at 0; it is the battery,
+// not the SoC, and the README says so.
+static string Get_CPU_Temp_File() {
+#ifdef TW_CUSTOM_CPU_TEMP_PATH
+	string custom = EXPAND(TW_CUSTOM_CPU_TEMP_PATH);
+	if (TWFunc::Path_Exists(custom))
+		return custom;
+#endif
+
+	string cpu_fallback;
+	string battery_fallback;
+	DIR* dir = opendir("/sys/class/thermal");
+	if (dir != NULL) {
+		struct dirent* de;
+		while ((de = readdir(dir)) != NULL) {
+			if (strncmp(de->d_name, "thermal_zone", 12) != 0)
+				continue;
+			string base = string("/sys/class/thermal/") + de->d_name;
+			string type_file = base + "/type";
+			string temp_file = base + "/temp";
+			string type;
+			if (!TWFunc::Path_Exists(temp_file) || TWFunc::read_file(type_file, type) != 0)
+				continue;
+			while (!type.empty() && (type[type.size() - 1] == '\n' || type[type.size() - 1] == ' '))
+				type.erase(type.size() - 1);
+			if (type == "mtktscpu" || type == "mtkcput" || type == "cpu" || type == "cpu-therm") {
+				closedir(dir);
+				return temp_file;
+			}
+			if (cpu_fallback.empty() && type.find("cpu") != string::npos)
+				cpu_fallback = temp_file;
+			if (battery_fallback.empty() && (type == "battery" || type == "mtktsbattery" || type == "mtk-gauge"))
+				battery_fallback = temp_file;
+		}
+		closedir(dir);
+	}
+	if (!cpu_fallback.empty())
+		return cpu_fallback;
+	if (!battery_fallback.empty()) {
+		LOGINFO("No CPU thermal zone in this kernel; using the battery zone\n");
+		return battery_fallback;
+	}
+	return "/sys/class/thermal/thermal_zone0/temp";
+}
