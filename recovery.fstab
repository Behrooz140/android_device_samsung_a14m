#
# TWRP fstab v2 - Samsung Galaxy A14 4G (SM-A145P / a14m)
# MediaTek MT6768 - Android 15 / One UI 7
#
# Partition names and mount options come from the stock recovery ramdisk:
#   system/etc/recovery.fstab  (build A145PXXSDDZH1)
#
# Format:
#   <mount point>  <fs type>  <device>  [device2]  flags=<flag>;<flag>;...
#
# NOTE: TWRP chooses the real filesystem at mount time (blkid probe), so one
# entry per mount point is enough. Duplicate mount points are NOT supported
# in this (v1-style) format: the extra line becomes a second partition with
# the same mount point and confuses TWRP.
#
# fsflags=ro is REQUIRED on every logical (super) partition: Samsung marks
# them read-only in the super metadata (liblp attr 0x1), so TWRP's dm devices
# are read-only and a read-write mount(2) fails with EACCES ("Permission
# denied"). With fsflags=ro TWRP passes MS_RDONLY and the mount succeeds.
#
# wipeingui is needed as well: TWRP hard-codes logical partitions as not
# wipable ("Is_Super ? false : true") while parsing the device column, and
# only later applies flags=, so this is the one way to list them in Advanced
# Wipe. Wiping the filesystem itself only works when the super metadata is
# writable; to restore a partition use Install Image -> <partition> instead.
#

# ---------------------------------------------------------------------------
# Dynamic (logical) partitions inside super
# ---------------------------------------------------------------------------
/system            erofs    system                              flags=display=system;logical;backup=1;flashimg=1;fsflags=ro;wipeingui

/vendor            erofs    vendor                              flags=display=vendor;logical;backup=1;flashimg=1;fsflags=ro;wipeingui

/product           erofs    product                             flags=display=product;logical;backup=1;flashimg=1;fsflags=ro;wipeingui

/odm               erofs    odm                                 flags=display=odm;logical;backup=1;flashimg=1;fsflags=ro;wipeingui

/system_ext        erofs    system_ext                          flags=display=system_ext;logical;backup=1;flashimg=1;fsflags=ro;wipeingui

/vendor_dlkm       erofs    vendor_dlkm                         flags=display=vendor_dlkm;logical;backup=1;flashimg=1;fsflags=ro;wipeingui

/system_dlkm       erofs    system_dlkm                         flags=display=system_dlkm;logical;backup=1;flashimg=1;fsflags=ro;wipeingui

/odm_dlkm          erofs    odm_dlkm                            flags=display=odm_dlkm;logical;backup=1;flashimg=1;fsflags=ro;wipeingui

# ---------------------------------------------------------------------------
# Boot / recovery / bootloader helper images (flashed as raw images)
# ---------------------------------------------------------------------------
/boot              emmc     /dev/block/by-name/boot             flags=display=boot;backup=1;flashimg=1
/recovery          emmc     /dev/block/by-name/recovery         flags=display=recovery;backup=1;flashimg=1
/init_boot         emmc     /dev/block/by-name/init_boot        flags=display=init_boot;backup=1;flashimg=1
/vendor_boot       emmc     /dev/block/by-name/vendor_boot      flags=display=vendor_boot;backup=1;flashimg=1
/dtbo              emmc     /dev/block/by-name/dtbo             flags=display=dtbo;backup=1;flashimg=1
/misc              emmc     /dev/block/by-name/misc             flags=display=misc

# ---------------------------------------------------------------------------
# Data / cache / metadata
#
# /data uses Android metadata encryption (dm-default-key): the raw userdata
# blocks are encrypted with a key stored in /metadata, so it can only be
# mounted after setting up dm-default-key (requires crypto support). Do not
# expect /data to mount while crypto is disabled.
# ---------------------------------------------------------------------------
/data              f2fs     /dev/block/by-name/userdata         flags=display=data;backup=1;wipeingui;canbewiped;storage;length=-16384
/cache             ext4     /dev/block/by-name/cache            flags=display=cache;backup=1;wipeingui;canbewiped
/metadata          ext4     /dev/block/by-name/md_udc           flags=display=metadata;wipeingui;canbewiped

# ---------------------------------------------------------------------------
# Samsung ODE / calibration partitions
#
# NEVER enable wipeingui/canbewiped on efs, persist or nvdata - they hold IMEI,
# radio calibration and sensor data and are not recoverable once erased.
# They are mounted read-only (fsflags=ro) and exposed only for backup.
#
# Removed on purpose (do not re-add):
#   keydata (p28) / keyrefuge (p27) - zeroed, no filesystem on this unit
#   carrier / preload (hidden)       - partition does not exist on a14m
# ---------------------------------------------------------------------------
/efs               ext4     /dev/block/by-name/sec_efs          flags=display=efs;backup=1;fsflags=ro
/persist           ext4     /dev/block/by-name/persist          flags=display=persist;backup=1;fsflags=ro
/nvdata            ext4     /dev/block/by-name/nvdata           flags=display=nvdata;backup=1;fsflags=ro
/prism             ext4     /dev/block/by-name/prism            flags=display=prism
/optics            ext4     /dev/block/by-name/optics           flags=display=optics
/md1img            emmc     /dev/block/by-name/md1img           flags=display=md1img
/spmfw             emmc     /dev/block/by-name/spmfw            flags=display=spmfw
/scp1              emmc     /dev/block/by-name/scp1             flags=display=scp1
/sspm_1            emmc     /dev/block/by-name/sspm_1           flags=display=sspm_1

# ---------------------------------------------------------------------------
# MicroSD card
# Kept at /external_sd so it does not collide with the internal /sdcard
# (which TWRP maps onto /data/media when RECOVERY_SDCARD_ON_DATA is set).
# ---------------------------------------------------------------------------
/external_sd       vfat     /dev/block/mmcblk1p1  /dev/block/mmcblk1  flags=display="MicroSD";storage;wipeingui;removable;backup=1
