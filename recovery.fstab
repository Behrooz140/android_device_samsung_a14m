# <mount_point>  <fstype>  <device>                           <flags>
/system          erofs     system                             flags=display="System";logical;slotselect
/system          f2fs      system                             flags=display="System";logical;slotselect
/system          ext4      system                             flags=display="System";logical;slotselect
/vendor          erofs     vendor                             flags=display="Vendor";logical;slotselect
/vendor          ext4      vendor                             flags=display="Vendor";logical;slotselect
/product         erofs     product                            flags=display="Product";logical;slotselect
/product         ext4      product                            flags=display="Product";logical;slotselect
/odm             erofs     odm                                flags=display="ODM";logical;slotselect
/odm             ext4      odm                                flags=display="ODM";logical;slotselect
/system_ext      erofs     system_ext                         flags=display="System_EXT";logical;slotselect
/system_ext      ext4      system_ext                         flags=display="System_EXT";logical;slotselect
/vendor_dlkm     erofs     vendor_dlkm                        flags=display="Vendor_DLKM";logical;slotselect
/vendor_dlkm     ext4      vendor_dlkm                        flags=display="Vendor_DLKM";logical;slotselect
/system_dlkm     erofs     system_dlkm                        flags=display="System_DLKM";logical;slotselect
/system_dlkm     f2fs      system_dlkm                        flags=display="System_DLKM";logical;slotselect
/system_dlkm     ext4      system_dlkm                        flags=display="System_DLKM";logical;slotselect
/odm_dlkm        erofs     odm_dlkm                           flags=display="ODM_DLKM";logical;slotselect

/boot            emmc      /dev/block/by-name/boot            flags=display="Boot";backup=1;flashimg=1
/recovery        emmc      /dev/block/by-name/recovery        flags=display="Recovery";backup=1;flashimg=1
/init_boot       emmc      /dev/block/by-name/init_boot       flags=display="Init_Boot";backup=1;flashimg=1
/vendor_boot     emmc      /dev/block/by-name/vendor_boot     flags=display="Vendor_Boot";backup=1;flashimg=1
/dtbo            emmc      /dev/block/by-name/dtbo            flags=display="DTBO";backup=1;flashimg=1
/vbmeta          emmc      /dev/block/by-name/vbmeta          flags=display="VBMeta";backup=1;flashimg=1

/data            f2fs      /dev/block/by-name/userdata        flags=display="Data";fileencryption=aes-256-xts:aes-256-cts:v2
/cache           ext4      /dev/block/by-name/cache           flags=display="Cache";wipeingui
/efs             ext4      /dev/block/by-name/sec_efs         flags=display="EFS";backup=1
/sec_efs         ext4      /dev/block/by-name/sec_efs         flags=display="Sec_EFS";backup=1
/metadata        ext4      /dev/block/by-name/md_udc          flags=display="Metadata";wipeingui
/optics          ext4      /dev/block/by-name/optics          flags=display="Optics";backup=1;flashimg=1
/prism           ext4      /dev/block/by-name/prism           flags=display="Prism";backup=1;flashimg=1
/misc            emmc      /dev/block/by-name/misc            flags=display="Misc"

# Removable storage
/sdcard1         auto      /dev/block/mmcblk1p1 /dev/block/mmcblk1   flags=display="MicroSD";storage;wipeingui;removable
/usb_otg         auto      /dev/block/sda1      /dev/block/sda       flags=display="USB-OTG";storage;wipeingui;removable
