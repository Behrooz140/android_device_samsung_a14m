on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0
    # one image serves every a14m variant: take ro.product.model from the
    # bootloader (ro.boot.em.model) before adbd and the TWRP GUI start
    exec_start model-from-bootloader

on fs
    # these are plain files in the device tree, and the ramdisk builder's
    # fs_config has no entry for /system/tee, so they are packed 0644
    chmod 0755 /system/tee/bin/dmctl
    chmod 0755 /system/tee/bin/service
    chmod 0755 /system/tee/bin/servicemanager
    # runs before the recovery binary parses the fstab, so one image serves
    # encrypted and plain firmware (metadata encryption adds keydirectory= to /data)
    exec_start fstab-crypto
    # MediaTek's regulator_vibrator comes up with brightness=max_brightness,
    # so the motor runs continuously until userspace clears it.  TWRP drives
    # it with brightness pulses (see patch 0017); make sure it starts silent.
    write /sys/class/leds/vibrator/trigger none
    write /sys/class/leds/vibrator/brightness 0
    # MTP over FunctionFS for TWRP's mtp/ffs server (it writes its descriptors
    # to /dev/usb-ffs/mtp/ep0).  TWRP's init.rc only sets up adb and fastboot;
    # the layout follows the stock vendor init.mt6768.usb.rc.
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1

# TWRP's Enable_MTP() switches sys.usb.config to "none" and then "mtp,adb".
# Without a configfs rule for "mtp,adb" nothing re-binds the UDC after "none",
# so enabling MTP dropped USB (adb included) until the next reboot.
on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    start adbd

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x4EE2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# TWRP's own "none" rule only removes f1
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2

on fs && property:ro.debuggable=0
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

on post-fs
    # Support A/B feature for EMMC and UFS boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils

on boot
    setprop servicemanager.ready true
    setprop twrp.decrypt.run 1
    # the vibrator module can finish probing after "on fs"
    write /sys/class/leds/vibrator/trigger none
    write /sys/class/leds/vibrator/brightness 0
    # adb/MTP never enumerate when the bootloader passes usb_restrict=1;
    # see usb_restrict.sh
    exec_start usb-restrict

on property:twrp.decrypt.run=1
    start decrypt

# ---------------------------------------------------------------------------
# Variant handling: one image for every a14m model and bootloader setting
# ---------------------------------------------------------------------------
# copies ro.boot.em.model into ro.product.*model (see model_from_bootloader.sh)
service model-from-bootloader /system/bin/model_from_bootloader.sh
    user root
    group root
    seclabel u:r:recovery:s0
    oneshot
    disabled

# forces musb into peripheral mode only if usb_restrict=1 (see usb_restrict.sh)
service usb-restrict /system/bin/usb_restrict.sh
    user root
    group root
    seclabel u:r:recovery:s0
    oneshot
    disabled

# ---------------------------------------------------------------------------
# Diagnostic helper: dumps touch/input/module/dmesg info to /sdcard, microSD
# and /cache shortly after TWRP has started.  See sbin/twrp-diag.sh.
# Harmless for normal use; remove this block (and sbin/twrp-diag.sh) once
# touch works.
# ---------------------------------------------------------------------------
service twrpdiag /system/bin/sh /sbin/twrp-diag.sh
    class default
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

# ---------------------------------------------------------------------------
# /data decryption (FBE v2 + metadata encryption).
#
# The 12.1 fscrypt code wants a keymaster 4 HIDL HAL, but this firmware only
# has KeyMint AIDL V1. These services run only what talks to the TEE: the
# TEEGRIS daemons, servicemanager, KeyMint and gatekeeper, using the Android 15
# libraries carried in /system/tee. The actual unlock is done by
# langsdorff_decrypt, driven from decrypt.sh (see the patches).
#
# The tee-* services are oneshot: one that cannot run on this vendor would
# otherwise restart every 5 seconds for good.
# ---------------------------------------------------------------------------
# runs before the recovery binary parses the fstab, so one image serves encrypted and plain firmware
service fstab-crypto /system/bin/fstab_crypto.sh
    user root
    group root system
    seclabel u:r:recovery:s0
    oneshot
    disabled

service decrypt /system/bin/decrypt.sh
    class main
    user root
    group root system
    seclabel u:r:recovery:s0
    oneshot
    disabled

# TEEGRIS hashes the exec'd image, so these two must not go through the bootstrap linker
service tee-tzdaemon /vendor/bin/tzdaemon
    class main
    user root
    group root system readproc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw
    seclabel u:r:recovery:s0
    oneshot
    disabled

service tee-tzts /vendor/bin/tzts_daemon
    class main
    user root
    group root system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw
    seclabel u:r:recovery:s0
    oneshot
    disabled

service tee-servicemanager /system/bin/hal_run.sh /system/tee/bin/servicemanager
    class core
    user root
    group root readproc
    seclabel u:r:recovery:s0
    oneshot
    disabled

service tee-keymint /system/bin/hal_run.sh /vendor/bin/hw/android.hardware.security.keymint-service
    class main
    user root
    group root system drmrpc
    seclabel u:r:recovery:s0
    oneshot
    disabled

service tee-gatekeeper /system/bin/hal_run.sh /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    class main
    user root
    group root system
    seclabel u:r:recovery:s0
    oneshot
    disabled

# keeps the userdata anchor busy so nothing short of data_release.sh unmounts it
service userdata-hold /system/bin/sh -c "cd /tmp/.userdata && exec sleep 2147483647"
    user root
    group root
    seclabel u:r:recovery:s0
    oneshot
    disabled
